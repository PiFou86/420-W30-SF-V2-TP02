<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>TP02_Menu.WinForms</RootNamespace>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TP02_Menu.Presentation/TP02_Menu.Presentation.csproj" />
    <ProjectReference Include="../TP02_Menu.Application/TP02_Menu.Application.csproj" />
    <ProjectReference Include="../TP02_Menu.Infrastructure/TP02_Menu.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../donnees-exemples/*.json" Link="donnees-exemples/%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
