    <ProjectReference Include="../TP02_Menu.Application/TP02_Menu.Application.csproj" />
    <ProjectReference Include="../TP02_Menu.Domaine/TP02_Menu.Domaine.csproj" />
    <ProjectReference Include="../TP02_Menu.Infrastructure/TP02_Menu.Infrastructure.csproj" />
    <ProjectReference Include="../TP02_Menu.Presentation/TP02_Menu.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../donnees-exemples/*.json" Link="donnees-exemples/%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
